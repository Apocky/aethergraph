{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Apocky/aethergraph/blob/main/schemas/aethergraph-ai-compact-v1.schema.json",
  "title": "Aethergraph compact AI JSONL line",
  "oneOf": [
    {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "source_schema", "source_sha256", "tags", "keys"],
      "properties": {
        "schema": { "const": "aethergraph.ai.compact.v1" },
        "source_schema": { "const": "aethergraph.ai.v1" },
        "source_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "tags": {
          "type": "object", "additionalProperties": false,
          "required": ["object", "array"],
          "properties": { "object": { "const": 0 }, "array": { "const": 1 } }
        },
        "keys": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }
      }
    },
    { "$ref": "#/$defs/encoded" }
  ],
  "$defs": {
    "encoded": {
      "oneOf": [
        { "type": ["string", "number", "boolean", "null"] },
        { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/encoded" } }
      ]
    }
  }
}
